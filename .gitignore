# Secrets — belt and braces. Nothing credential-shaped may ever be committed.
*.env
!*.env.example
secrets/
*.pem
*.key
plaid-items.json
access_token*

# Local data — the net-worth database and any exports are private and local-only.
data/
*.db
*.db-journal
*.db-wal
*.sqlite
*.sqlite3

# Snapshots, payloads and backups. Encrypted or not, these are the owner's
# balances; a public repo makes one committed file permanent (DESIGN.md §15).
snapshot*.json
*.json.enc
*.enc
*.age
backups/
exports/
*.csv

# Android release signing — the keystore and its password file (DESIGN.md §17).
key.properties
*.jks
*.keystore
*.p12
*.apk
*.aab

# Runtime
logs/
*.log
.venv/
venv/
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.mypy_cache/
node_modules/

# macOS
.DS_Store
